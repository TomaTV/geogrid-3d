{
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/geogrid-3d/browser",
  "functions": {
    "api/collection.mjs": { "includeFiles": "db.seed.json" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/collection?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
